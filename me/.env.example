# ---------------------------------------------------------------------------
# Jimmy Pro configuration
# Copy this file to .env and fill in your Safaricom Daraja credentials.
#
# Where to get them:
#   1. Create a free account on https://developer.safaricom.co.ke
#   2. Create an app -> you get a Consumer Key + Consumer Secret
#   3. Sandbox test passkey (Lipa na M-Pesa Online): bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
#   4. Sandbox shortcode: 174379
#
# You can also paste these in the app UI (Settings). Environment variables
# always win over values saved in the UI.
# ---------------------------------------------------------------------------

PORT=3000

# sandbox | production
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Lipa na M-Pesa Online passkey (sandbox key shown above)
MPESA_PASSKEY=

# Paybill / Till number that receives the money
MPESA_SHORTCODE=174379

# CustomerPayBillOnline (paybill) | CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Public URL Safaricom calls back. Must be https and reachable from internet.
# Example: https://jimmypro.example.com/api/mpesa/callback
MPESA_CALLBACK_URL=

# The operator's own handset. Shown as the owner and used as the payout default.
# It can NOT receive an STK push - Daraja settles to MPESA_SHORTCODE only.
MPESA_OWNER_MSISDN=

# Business name shown on the public payment page
BUSINESS_NAME=Jimmy Pro

# Optional: if set, Settings changes require this PIN (sent as x-admin-pin header)
ADMIN_PIN=

# ---------------------------------------------------------------------------
# Business APIs
# ---------------------------------------------------------------------------

# B2B: the M-Pesa API operator username created on the Daraja portal
MPESA_INITIATOR_NAME=

# B2B: that operator's password. The server RSA-encrypts it with Safaricom's
# certificate to build the SecurityCredential (do not paste the encrypted form
# into this field unless you already have one - see MPESA_SECURITY_CREDENTIAL).
MPESA_INITIATOR_PASSWORD=

# Optional: a ready-made base64 SecurityCredential. Skips the encryption step.
MPESA_SECURITY_CREDENTIAL=

# Where db.json lives. Kept outside server/ so --watch does not restart on writes.
DATA_DIR=

# Where the Safaricom public certificate lives (see certs/README.md)
MPESA_CERT_PATH=./certs/safaricom.cer

# Your sending shortcode (Party A). Defaults to MPESA_SHORTCODE.
MPESA_B2B_PARTY_A=

# BusinessPayBill | BusinessBuyGoods | DisburseFundsToBusiness |
# BusinessToBusinessTransfer | MerchantToMerchantTransfer
MPESA_B2B_COMMAND_ID=BusinessPayBill

# Public https URLs Safaricom posts the B2B result to
MPESA_RESULT_URL=
MPESA_TIMEOUT_URL=

# Shortcode used for KYC validation. Defaults to MPESA_SHORTCODE.
MPESA_KYC_SHORTCODE=
